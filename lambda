#!/usr/bin/env escript
%% -*- erlang -*-


main(Args) ->
    %% The generated scanner and parser live next to this script.
    code:add_patha(filename:dirname(filename:absname(escript:script_name()))),
    case opts(Args) of
    {error, Message} ->
        report(Message),
        usage(standard_error),
        halt(1);
    #{help := true} ->
        usage(standard_io),
        halt(0);
    #{file := File} = Opts ->
        run(File, Opts);
    _ ->
        usage(standard_error),
        halt(1)
    end.


usage(Device) ->
    io:format(Device,
              "usage: lambda [--help] [--full] [--step] <file>~n",
              []).


opts(Args) ->
    opts(Args, #{}).

opts([], Opts) -> Opts;
opts(["--help" | Rest], Opts) -> opts(Rest, Opts#{help => true});
opts(["--full" | Rest], Opts) -> opts(Rest, Opts#{full => true});
opts(["--step" | Rest], Opts) -> opts(Rest, Opts#{step => true});
opts(["--" ++ _ = Option | _], _Opts) ->
    {error, "unknown option: " ++ Option};
opts([File | _], #{file := _}) ->
    {error, "unexpected extra argument: " ++ File};
opts([File | Rest], Opts) ->
    opts(Rest, Opts#{file => File}).


report(Message) ->
    %% Messages are chardata and may contain characters outside Latin-1 (an
    %% illegal token in a UTF-8 source can supply one). ~s rejects those
    %% characters, so print with ~ts.
    io:format(standard_error, "lambda: ~ts~n", [Message]).


run(File, Opts) ->
    TermResult = case ensure_modules() of
    ok -> read_term(File);
    {error, _} = Error -> Error
    end,
    case TermResult of
    {ok, Term} ->
        NormalForm = eval(Term, Opts),
        io:format("Result:~n~s~n", [show(NormalForm, Opts)]),
        halt(0);
    {error, Message} ->
        report(Message),
        halt(1)
    end.


ensure_modules() ->
    case {code:ensure_loaded(lambda_scanner),
          code:ensure_loaded(lambda_parse)} of
    {{module, _}, {module, _}} -> ensure_current();
    _ -> {error, "scanner/parser modules are not built; run ./bootstrap"}
    end.


%% A beam older than the grammar it was generated from still loads, so an
%% edited .xrl or .yrl would silently run the previous scanner or parser. A
%% missing source proves nothing, so it is ignored.
ensure_current() ->
    ensure_current([{lambda_scanner, "lambda_scanner.xrl"},
                    {lambda_parse, "lambda_parse.yrl"}]).

ensure_current([]) ->
    ok;
ensure_current([{Module, Source} | Rest]) ->
    Beam = code:which(Module),
    BeamTime = filelib:last_modified(Beam),
    SourcePath = filename:join(filename:dirname(Beam), Source),
    SourceTime = filelib:last_modified(SourcePath),
    case SourceTime > BeamTime of
    true ->
        {error, filename:basename(Beam) ++ " is older than " ++ Source ++
                "; run ./bootstrap"};
    false ->
        ensure_current(Rest)
    end.


read_term(File) ->
    case file:read_file(File) of
    {ok, Binary} -> parse_text(File, Binary);
    {error, Reason} -> {error, File ++ ": " ++ file:format_error(Reason)}
    end.


parse_text(File, Binary) ->
    case unicode:characters_to_list(Binary, utf8) of
    Text when is_list(Text) -> parse(Text);
    _ -> {error, File ++ ": not valid UTF-8"}
    end.


parse(String) ->
    case lambda_scanner:string(String) of
    {ok, Tokens, _} ->
        case lambda_parse:parse(Tokens) of
        {ok, Program} -> {ok, bind_defs(Program)};
        {error, Error} -> {error, format_error(Error)}
        end;
    {error, Error, _} ->
        {error, format_error(Error)}
    end.


format_error({Line, Module, Description}) ->
    case lists:flatten(Module:format_error(Description)) of
    %% The end token carries no text, so yecc's message ends after the colon.
    "syntax error before: " -> "unexpected end of file";
    Text -> io_lib:format("line ~w: ~ts", [Line, Text])
    end.


%% Definitions bind to the right, so [a = E; b = F; G] means (\a.(\b.G) F) E.
bind_defs([{def, Name, Expression} | Rest]) ->
    {app, {abs, Name, bind_defs(Rest)}, Expression};
bind_defs([Expression]) -> Expression.


%% io:format("~s") accepts the printers' iolists directly, so no explicit
%% flattening is needed here.
show(Term, #{full := true}) -> full(Term);
show(Term,              _) -> abbr(Term).

full({var, Name}) -> Name;
full({abs, Binder, Body}) -> ["(", "\\", Binder, ".", full(Body), ")"];
full({app, Function, Argument}) -> ["(", full(Function), " ", full(Argument), ")"].

abbr({var, Name}) -> Name;
abbr({abs, Binder, Body}) -> ["\\", Binder, ".", abbr(Body)];
abbr({app, Function, Argument}) -> [abbr_fun(Function), " ", abbr_arg(Argument)].

abbr_fun({abs, _, _} = Function) -> ["(", abbr(Function), ")"];
%% Parenthesized so that re-parsing does not extend the abstraction body.
abbr_fun({app, Function, {abs, _, _} = Argument}) ->
    [abbr_fun(Function), " ", "(", abbr(Argument), ")"];
abbr_fun(Function) -> abbr(Function).

abbr_arg({app, _, _} = Argument) -> ["(", abbr(Argument), ")"];
abbr_arg(Argument) -> abbr(Argument).


eval(Term, Opts) ->
    eval(Term, Opts, 0).

eval(Term, Opts, Step) ->
    print_step(Term, Opts, Step),
    case beta_reduction(Term) of
    none -> Term;
    {reduced, ReducedTerm} -> eval(ReducedTerm, Opts, Step + 1)
    end.

print_step(Term, #{step := true} = Opts, Step) ->
    io:format("Step ~w:~n~s~n", [Step, show(Term, Opts)]);
print_step(_, _, _) ->
    ok.


%% Contract the leftmost outermost beta-redex, including under abstractions,
%% so a normal form is found whenever one exists. Return {reduced, Term}
%% even when contraction reproduces the input; only none signals normal form.
beta_reduction({var, _}) -> none;
beta_reduction({abs, Binder, Body}) ->
    case beta_reduction(Body) of
    {reduced, ReducedBody} -> {reduced, {abs, Binder, ReducedBody}};
    none -> none
    end;
beta_reduction({app, {abs, Binder, Body}, Argument}) ->
    {reduced, subs(Body, Binder, Argument)};
beta_reduction({app, Function, Argument}) ->
    case beta_reduction(Function) of
    {reduced, ReducedFunction} -> {reduced, {app, ReducedFunction, Argument}};
    none ->
        case beta_reduction(Argument) of
        {reduced, ReducedArgument} -> {reduced, {app, Function, ReducedArgument}};
        none -> none
        end
    end.


%% Substitute Replacement for free occurrences of Target, avoiding capture.
%% Cache Replacement's free variables across the traversal to avoid repeated
%% scans. Renaming also excludes Body's free variables to avoid capture;
%% bound-name collisions are handled by capture-avoiding substitution itself.
subs({var, Target}, Target, Replacement) -> Replacement;
subs({var, _} = Term, _, _) -> Term;
subs({abs, Target, _} = Term, Target, _) -> Term;
subs(Term, Target, Replacement) ->
    subs(Term, Target, Replacement, free_vars(Replacement)).

subs({var, Target}, Target, Replacement, _ReplacementFreeVars) -> Replacement;
subs({var, _} = Term, _, _, _ReplacementFreeVars) -> Term;
subs({abs, Target, _} = Term, Target, _, _ReplacementFreeVars) -> Term;
subs({abs, Binder, Body} = Term, Target, Replacement, ReplacementFreeVars) ->
    case occurs_free(Target, Body) of
    false ->
        Term;
    true when is_map_key(Binder, ReplacementFreeVars) ->
        FreshName = fresh_name(maps:merge(free_vars(Body), ReplacementFreeVars)),
        RenamedBody = subs(Body, Binder, {var, FreshName}),
        {abs, FreshName, subs(RenamedBody, Target, Replacement, ReplacementFreeVars)};
    true ->
        {abs, Binder, subs(Body, Target, Replacement, ReplacementFreeVars)}
    end;
subs({app, Function, Argument}, Target, Replacement, ReplacementFreeVars) ->
    {app, subs(Function, Target, Replacement, ReplacementFreeVars),
          subs(Argument, Target, Replacement, ReplacementFreeVars)}.


occurs_free(Target, {var, Name}) -> Target =:= Name;
occurs_free(Target, {abs, Binder, Body}) ->
    Target =/= Binder andalso occurs_free(Target, Body);
occurs_free(Target, {app, Function, Argument}) ->
    occurs_free(Target, Function) orelse occurs_free(Target, Argument).


free_vars({var, Name}) -> #{Name => true};
free_vars({abs, Binder, Body}) ->
    maps:remove(Binder, free_vars(Body));
free_vars({app, Function, Argument}) ->
    maps:merge(free_vars(Function), free_vars(Argument)).


fresh_name(FreeVars) -> fresh_name(FreeVars, [$a]).

fresh_name(FreeVars, Candidate) ->
    case maps:is_key(Candidate, FreeVars) of
    true -> fresh_name(FreeVars, next_name(Candidate));
    false -> Candidate
    end.

%% Candidates stay within source identifier syntax and never repeat, so the
%% search can always escape a finite set of names.
next_name(Name) ->
    case lists:reverse(Name) of
    [$z | ReversedPrefix] -> lists:reverse(ReversedPrefix, [$A]);
    [$Z | _] -> Name ++ [$a];
    [LastChar | ReversedPrefix] -> lists:reverse(ReversedPrefix, [LastChar + 1])
    end.
