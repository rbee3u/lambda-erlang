#!/usr/bin/env escript
%% -*- erlang -*-


main(Args) ->
    %% The generated scanner and parser live next to this script.
    code:add_patha(filename:dirname(filename:absname(escript:script_name()))),
    case opts(Args) of
    {error, Message} ->
        report(Message),
        usage(standard_error),
        halt(1);
    #{help := true} ->
        usage(standard_io),
        halt(0);
    #{file := File} = Opts ->
        run(File, Opts);
    %% Well-formed options that name no file: only the usage line can help.
    _ ->
        usage(standard_error),
        halt(1)
    end.


usage(Device) ->
    io:format(Device,
              "usage: lambda [--help] [--full] [--step] <file>~n",
              []).


opts(Args) ->
    opts(Args, #{}).

opts([], Opts) -> Opts;
opts(["--help" | T], Opts) -> opts(T, Opts#{help => true});
opts(["--full" | T], Opts) -> opts(T, Opts#{full => true});
opts(["--step" | T], Opts) -> opts(T, Opts#{step => true});
opts(["--" ++ _ = Option | _], _Opts) ->
    {error, "unknown option: " ++ Option};
opts([File | _], #{file := _}) ->
    {error, "unexpected extra argument: " ++ File};
opts([File | T], Opts) ->
    opts(T, Opts#{file => File}).


report(Message) ->
    %% Messages are chardata and may contain characters outside Latin-1 (an
    %% illegal token in a UTF-8 source can supply one). ~s rejects those
    %% characters, so print with ~ts.
    io:format(standard_error, "lambda: ~ts~n", [Message]).


run(File, Opts) ->
    case ensure_modules() of
    ok ->
        run_file(File, Opts);
    {error, Message} ->
        report(Message),
        halt(1)
    end.


ensure_modules() ->
    %% The scanner and parser are generated by ./bootstrap.
    case {code:ensure_loaded(lambda_scanner),
          code:ensure_loaded(lambda_parse)} of
    {{module, _}, {module, _}} -> ensure_current();
    _ -> {error, "scanner/parser modules are not built; run ./bootstrap"}
    end.


%% A beam older than the grammar it was generated from still loads, so an
%% edited .xrl or .yrl would silently run the previous scanner or parser. A
%% missing source proves nothing, so it is ignored.
ensure_current() ->
    ensure_current([{lambda_scanner, "lambda_scanner.xrl"},
                    {lambda_parse, "lambda_parse.yrl"}]).

ensure_current([]) ->
    ok;
ensure_current([{Module, Source} | T]) ->
    Beam = code:which(Module),
    BeamTime = filelib:last_modified(Beam),
    SourcePath = filename:join(filename:dirname(Beam), Source),
    SourceTime = filelib:last_modified(SourcePath),
    case SourceTime > BeamTime of
    true ->
        {error, filename:basename(Beam) ++ " is older than " ++ Source ++
                "; run ./bootstrap"};
    false ->
        ensure_current(T)
    end.


run_file(File, Opts) ->
    case read_term(File) of
    {ok, Term} ->
        io:format("Result:~n~s~n", [show(eval(Term, Opts), Opts)]),
        halt(0);
    {error, Message} ->
        report(Message),
        halt(1)
    end.


read_term(File) ->
    case file:read_file(File) of
    {ok, Binary} -> parse_text(File, Binary);
    {error, Reason} -> {error, File ++ ": " ++ file:format_error(Reason)}
    end.


%% characters_to_list/2 returns the decoded text, or {error, Decoded, Rest}
%% or {incomplete, Decoded, Rest} when the bytes are not valid UTF-8.
parse_text(File, Binary) ->
    case unicode:characters_to_list(Binary, utf8) of
    Text when is_list(Text) -> parse(Text);
    _ -> {error, File ++ ": not valid UTF-8"}
    end.


parse(String) ->
    case lambda_scanner:string(String) of
    {ok, Tokens, _} ->
        case lambda_parse:parse(Tokens) of
        {ok, Term} -> {ok, bind_defs(Term)};
        {error, Error} -> {error, format_error(Error)}
        end;
    {error, Error, _} ->
        {error, format_error(Error)}
    end.


format_error({Line, Module, Description}) ->
    case lists:flatten(Module:format_error(Description)) of
    %% The end token carries no text, so yecc's message ends after the colon.
    "syntax error before: " -> "unexpected end of file";
    Text -> io_lib:format("line ~w: ~ts", [Line, Text])
    end.


%% Definitions bind to the right, so [a = E; b = F; G] means (\a.(\b.G) F) E.
bind_defs([{def, X, E} | T]) -> {app, {abs, X, bind_defs(T)}, E};
bind_defs([Expression]) -> Expression.


%% The printers return iolists, which io:format("~s") accepts as they are, so
%% a large term is never flattened into a second copy.
show(T, #{full := true}) -> full(T);
show(T,               _) -> abbr(T).

full({var, X})    -> X;
full({abs, X, E}) -> ["(", "\\", X, ".", full(E), ")"];
full({app, F, A}) -> ["(", full(F), " ", full(A), ")"].

abbr({var, X})    -> X;
abbr({abs, X, E}) -> ["\\", X, ".", abbr(E)];
abbr({app, F, A}) -> [abbr_fun(F), " ", abbr_arg(A)].

abbr_fun({var, _}    = F) -> abbr(F);
abbr_fun({abs, _, _} = F) -> ["(", abbr(F), ")"];
%% Parenthesized so that re-parsing does not extend the abstraction body.
abbr_fun({app, F, {abs, _, _} = A}) ->
    [abbr_fun(F), " ", "(", abbr_arg(A), ")"];
abbr_fun({app, F, A}) -> [abbr_fun(F), " ", abbr_arg(A)].

abbr_arg({var, _}    = A) -> abbr(A);
abbr_arg({abs, _, _} = A) -> abbr(A);
abbr_arg({app, _, _} = A) -> ["(", abbr(A), ")"].


eval(T, Opts) ->
    eval(T, Opts, 0).

eval(T, Opts, Step) ->
    print_step(T, Opts, Step),
    case beta_reduction(T) of
    none -> T;
    {reduced, T2} -> eval(T2, Opts, Step + 1)
    end.

print_step(T, #{step := true} = Opts, Step) ->
    io:format("Step ~w:~n~s~n", [Step, show(T, Opts)]);
print_step(_, _, _) ->
    ok.


%% Normal order: reduce under abstractions, and reduce an application's
%% function before its argument, so a normal form is found whenever one
%% exists.
beta_reduction({var, _}) -> none;
beta_reduction({abs, X, E}) ->
    case beta_reduction(E) of
    {reduced, E2} -> {reduced, {abs, X, E2}};
    none -> none
    end;
beta_reduction({app, {abs, X, E}, A}) ->
    {reduced, subs(E, X, A)};
beta_reduction({app, F, A}) ->
    case beta_reduction(F) of
    {reduced, F2} -> {reduced, {app, F2, A}};
    none ->
        case beta_reduction(A) of
        {reduced, A2} -> {reduced, {app, F, A2}};
        none -> none
        end
    end.


%% Capture-avoiding substitution: replace free occurrences of X in T with R.
%% free(R) is computed once per substitution, and free(E) only when a binder
%% must be renamed, so the hot path does not rebuild both sets at each binder.
subs(T, X, R) ->
    subs(T, X, R, free(R)).

subs({var, X}, X, R, _FreeR) -> R;
subs({var, _} = T, _, _, _FreeR) -> T;
subs({abs, X, _} = T, X, _, _FreeR) -> T;
subs({abs, Y, E} = T, X, R, FreeR) ->
    case occurs(X, E) of
    false ->
        T;
    true ->
        case maps:is_key(Y, FreeR) of
        false ->
            {abs, Y, subs(E, X, R, FreeR)};
        true ->
            Z = fresh_name(maps:merge(free(E), FreeR)),
            {abs, Z, subs(subs(E, Y, {var, Z}), X, R, FreeR)}
        end
    end;
subs({app, F, A}, X, R, FreeR) ->
    {app, subs(F, X, R, FreeR), subs(A, X, R, FreeR)}.


occurs(X, {var, Y}) -> X =:= Y;
occurs(X, {abs, Y, E}) -> X =/= Y andalso occurs(X, E);
occurs(X, {app, F, A}) -> occurs(X, F) orelse occurs(X, A).


free({var, X}) -> #{X => true};
free({abs, X, E}) ->
    maps:remove(X, free(E));
free({app, F, A}) ->
    maps:merge(free(F), free(A)).


fresh_name(Free) -> fresh_name(Free, [$a]).

fresh_name(Free, Key) ->
    case maps:is_key(Key, Free) of
    true -> fresh_name(Free, next_name(Key));
    false -> Key
    end.

%% Enumerate fresh names by advancing the last letter, rolling z to A and
%% extending names that end in Z; the sequence is unbounded, so fresh_name/1
%% terminates.
next_name(Key) ->
    case lists:reverse(Key) of
    [$z | Rev] -> lists:reverse(Rev, [$A]);
    [$Z | _] -> Key ++ [$a];
    [C | Rev] -> lists:reverse(Rev, [C + 1])
    end.
